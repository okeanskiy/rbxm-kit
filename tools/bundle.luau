--!strict

--[[
	Inline an entry script and every module it requires by relative path into one Luau file.

	`lune build` embeds only its input file, so a multi-module program must be flattened first.
	Each module becomes a function in a table, memoised on first require exactly like `require`.
	`@lune/*` requires are left alone because the Lune runtime provides them.

	Supported: string-literal relative requires (`require("./x")`, `require("../src/x")`) that
	resolve to `<path>.luau` or `<path>/init.luau`. Anything else fails the bundle loudly.
]]

local fs = require("@lune/fs")

local Bundle = {}

local function dirname(path: string): string
	return string.match(path, "^(.*)/[^/]*$") or "."
end

local function normalize(path: string): string
	local parts = {}
	for part in string.gmatch(path, "[^/]+") do
		if part == ".." then
			if #parts == 0 or parts[#parts] == ".." then
				table.insert(parts, part)
			else
				table.remove(parts)
			end
		elseif part ~= "." then
			table.insert(parts, part)
		end
	end
	return table.concat(parts, "/")
end

local function resolve(fromFile: string, specifier: string): string
	local base = normalize(`{dirname(fromFile)}/{specifier}`)
	for _, candidate in { `{base}.luau`, `{base}/init.luau` } do
		if fs.isFile(candidate) then
			return candidate
		end
	end
	error(`{fromFile}: cannot resolve require("{specifier}")`, 0)
end

--- Bundle `entry` (a path relative to the working directory) and return the combined source.
function Bundle.bundle(entry: string): string
	local order: { string } = {}
	local sources: { [string]: string } = {}

	local function visit(path: string)
		if sources[path] then
			return
		end
		sources[path] = "" -- mark before recursing so cycles terminate
		local source = fs.readFile(path)

		-- Resolve first: Lune's fs calls yield, which is not allowed inside a gsub callback.
		local REQUIRE = 'require%(%s*"([^"]+)"%s*%)'
		local dependencies: { string } = {}
		local targets: { [string]: string } = {}
		for specifier in string.gmatch(source, REQUIRE) do
			if string.sub(specifier, 1, 1) ~= "@" and targets[specifier] == nil then
				if string.sub(specifier, 1, 2) ~= "./" and string.sub(specifier, 1, 3) ~= "../" then
					error(`{path}: unsupported require("{specifier}")`, 0)
				end
				targets[specifier] = resolve(path, specifier)
				table.insert(dependencies, targets[specifier])
			end
		end
		source = string.gsub(source, REQUIRE, function(specifier: string): string?
			local target = targets[specifier]
			return if target then `__bundleRequire("{target}")` else nil
		end)
		-- Module bodies become function bodies, where `export type` is not allowed. Types are not
		-- checked at runtime, so a local type alias is equivalent.
		source = string.gsub(source, "\nexport type ", "\ntype ")
		sources[path] = source

		for _, dependency in dependencies do
			visit(dependency)
		end
		table.insert(order, path)
	end

	visit(normalize(entry))

	local chunks = {
		"-- Generated by tools/bundle.luau. Do not edit.",
		"local __bundleModules: { [string]: () -> any } = {}",
		"local __bundleLoaded: { [string]: any } = {}",
		"local function __bundleRequire(path: string): any",
		"\tlocal loaded = __bundleLoaded[path]",
		"\tif loaded == nil then",
		"\t\tloaded = __bundleModules[path]()",
		"\t\t__bundleLoaded[path] = loaded",
		"\tend",
		"\treturn loaded",
		"end",
	}
	for _, path in order do
		table.insert(chunks, `__bundleModules["{path}"] = function()\n{sources[path]}\nend`)
	end
	table.insert(chunks, `return __bundleRequire("{normalize(entry)}")`)
	return table.concat(chunks, "\n") .. "\n"
end

return Bundle
